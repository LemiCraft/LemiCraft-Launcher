{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LemiCraft Launcher",
  "mainBinaryName": "LemiCraft-Launcher",
  "version": "2.0.1",
  "identifier": "ru.lemicraft.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lemicraft"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "LemiCraft Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#141317",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
